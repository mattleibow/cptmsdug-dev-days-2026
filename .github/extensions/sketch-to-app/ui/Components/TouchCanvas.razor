@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="board" style="aspect-ratio:@Width / @Height" @ref="_board">
    @ChildContent
    <div class="pointer-layer" style="pointer-events:@(Disabled || _module is null ? "none" : "auto")"
         @onpointerdown="PointerDown" @onpointermove="PointerMove"
         @onpointerup="PointerUp" @onpointercancel="PointerCancel"
         aria-label="@Label"></div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public int Width { get; set; } = 1200;
    [Parameter] public int Height { get; set; } = 800;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string Label { get; set; } = "Drawing surface";
    [Parameter] public EventCallback<CanvasPosition> OnStart { get; set; }
    [Parameter] public EventCallback<CanvasPosition> OnMove { get; set; }
    [Parameter] public EventCallback<CanvasPosition> OnEnd { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<string> OnError { get; set; }

    private ElementReference _board;
    private IJSObjectReference? _module;
    private long? _pointerId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "./touch-canvas.js");
                StateHasChanged();
            }
            catch (JSException ex)
            {
                await OnError.InvokeAsync($"Drawing could not start: {ex.Message}");
            }
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Width <= 0)
            throw new ArgumentOutOfRangeException(nameof(Width), "Canvas dimensions must be positive.");
        if (Height <= 0)
            throw new ArgumentOutOfRangeException(nameof(Height), "Canvas dimensions must be positive.");
        if (!Disabled || _pointerId is not long pointerId)
            return;
        _pointerId = null;
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("end", _board, pointerId);
            }
            catch (JSException ex)
            {
                await OnError.InvokeAsync($"Drawing interrupted: {ex.Message}");
            }
        }
        await OnCancel.InvokeAsync();
    }

    private async Task PointerDown(PointerEventArgs e)
    {
        if (Disabled || _module is null || _pointerId is not null ||
            (e.PointerType == "mouse" && e.Button != 0))
            return;
        _pointerId = e.PointerId;
        try
        {
            var point = await _module.InvokeAsync<CanvasPosition>("start",
                _board, e.PointerId, e.ClientX, e.ClientY, Width, Height);
            if (_pointerId == e.PointerId)
                await OnStart.InvokeAsync(point);
        }
        catch (JSException ex)
        {
            _pointerId = null;
            await OnError.InvokeAsync($"Drawing could not start: {ex.Message}");
        }
    }

    private async Task PointerMove(PointerEventArgs e)
    {
        if (_pointerId != e.PointerId || _module is null)
            return;
        try
        {
            var point = await _module.InvokeAsync<CanvasPosition>("point",
                _board, e.ClientX, e.ClientY, Width, Height);
            if (_pointerId == e.PointerId)
                await OnMove.InvokeAsync(point);
        }
        catch (JSException ex)
        {
            _pointerId = null;
            await OnCancel.InvokeAsync();
            await OnError.InvokeAsync($"Drawing interrupted: {ex.Message}");
        }
    }

    private async Task PointerUp(PointerEventArgs e)
    {
        if (_pointerId != e.PointerId || _module is null)
            return;
        _pointerId = null;
        try
        {
            var point = await _module.InvokeAsync<CanvasPosition>("point",
                _board, e.ClientX, e.ClientY, Width, Height);
            await _module.InvokeVoidAsync("end", _board, e.PointerId);
            await OnEnd.InvokeAsync(point);
        }
        catch (JSException ex)
        {
            await OnCancel.InvokeAsync();
            await OnError.InvokeAsync($"Drawing interrupted: {ex.Message}");
        }
    }

    private Task PointerCancel(PointerEventArgs e)
    {
        if (_pointerId != e.PointerId)
            return Task.CompletedTask;
        _pointerId = null;
        return OnCancel.InvokeAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            await _module.DisposeAsync();
    }
}
