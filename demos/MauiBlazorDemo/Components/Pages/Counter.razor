@page "/counter"
@using CounterCore

<h1>Counter</h1>

<p role="status">Current count: @counter.Count</p>

<button class="btn btn-primary" @onclick="IncrementCount">Click me</button>

@code {
    private readonly CounterService counter = new();

    private void IncrementCount()
    {
        counter.Increment();
    }
}
