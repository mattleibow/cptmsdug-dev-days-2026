@page "/"
@using SkiaSharp
@using SkiaSharp.Views.Blazor
@using SketchToApp.Web.Components
@using SketchToApp.Web.Models
@using SketchToApp.Web.Services
@implements IAsyncDisposable
@inject BoardApi Api
@inject IJSRuntime JS

<PageTitle>Sketch to app</PageTitle>

<header class="app-header">
    <div>
        <p class="eyebrow">Sketch to app</p>
        <h1>Sketch whiteboard</h1>
        <p class="intro">Draw freely. Ask Copilot in chat to load an image, read the board, save a PNG, or build from it.</p>
    </div>
</header>

@if (!_ready)
{
    <section class="notice" role="status">
        @if (_loading)
        {
            <p>Loading your saved board…</p>
        }
        else
        {
            <p>@_error</p>
            <button @onclick="LoadAsync">Retry loading</button>
        }
    </section>
}
else
{
    <section class="workspace" aria-label="Sketch board">
        <div class="toolbar" role="toolbar" aria-label="Drawing tools">
            <button class="@(_tool == "pen" ? "selected" : "")" disabled="@_busy" aria-pressed="@(_tool == "pen")" @onclick="SelectPen">Pen</button>
            <button class="@(_tool == "eraser" ? "selected" : "")" disabled="@_busy" aria-pressed="@(_tool == "eraser")" @onclick="SelectEraser">Eraser</button>
            <label>Color <input type="color" value="@_color" disabled="@(_busy || _tool == "eraser")" @onchange="e => _color = e.Value?.ToString() ?? _color" /></label>
            <label>Size <input type="range" min="2" max="28" value="@_size" disabled="@_busy" @oninput="e => _size = int.TryParse(e.Value?.ToString(), out var size) ? size : _size" /></label>
            <button disabled="@(_busy || _document.Strokes.Count == 0)" @onclick="Undo">Undo</button>
            <button disabled="@(_busy || (_document.Strokes.Count == 0 && _document.BackgroundPngBase64 is null))" @onclick="Clear">Clear board</button>
            <span class="spacer"></span>
            <span class="status" role="status">@(_importing ? "Importing…" : _saving ? "Saving…" : _revision == _savedRevision ? "Auto-saved" : "Unsaved changes")</span>
        </div>

        <div class="board-frame">
            <TouchCanvas Width="_document.Width" Height="_document.Height"
                         Disabled="@(_busy || _loading || _conflict)" Label="Freeform drawing surface"
                         OnStart="StartStroke" OnMove="AddPoint" OnEnd="EndStroke"
                         OnCancel="CancelStroke" OnError="DrawingError">
                <SKCanvasView @ref="_canvas" class="sketch-canvas" IgnorePixelScaling="true" OnPaintSurface="Paint" />
            </TouchCanvas>
        </div>

        <label class="notes-label" for="board-notes">Notes for Copilot</label>
        <textarea id="board-notes" maxlength="10000" rows="4" disabled="@_busy"
                  placeholder="Describe interactions and anything the drawing cannot show."
                  value="@_document.Notes" @oninput="NotesChanged"></textarea>
        <p class="hint">The board and notes auto-save in this session. Ask Copilot in chat to view or save the PNG, load a PNG/JPEG, edit notes, or build an app from your sketch.</p>
    </section>
}

@if (!_eventsConnected && _ready)
{
    <section class="notice error" role="alert">Board updates disconnected. Reconnecting…</section>
}
@if (!string.IsNullOrWhiteSpace(_syncError))
{
    <section class="notice error" role="alert">@_syncError</section>
}
@if (!string.IsNullOrWhiteSpace(_error) && _ready)
{
    <section class="notice error" role="alert">
        <p>@_error</p>
        @if (_conflict)
        {
            <button @onclick="LoadAsync">Discard local changes and reload latest board</button>
        }
        else if (_importError)
        {
            <button disabled="@_busy" @onclick="LoadAsync">Retry image import</button>
        }
        else
        {
            <button disabled="@_busy" @onclick="RetrySaveAsync">Retry save</button>
        }
    </section>
}
@if (!string.IsNullOrWhiteSpace(_result))
{
    <section class="notice success" role="status">@_result</section>
}

@code {
    private const int MaxStrokes = 800;
    private const int MaxPoints = 80000;
    private const int MaxPointsPerStroke = 4000;
    private readonly SemaphoreSlim _saveGate = new(1, 1);
    private BoardDocument _document = new();
    private SKImage? _background;
    private BoardStroke? _activeStroke;
    private SKCanvasView? _canvas;
    private IJSObjectReference? _eventModule;
    private IJSObjectReference? _events;
    private DotNetObjectReference<Home>? _dotNetRef;
    private CancellationTokenSource? _debounce;
    private long _revision;
    private long _savedRevision;
    private int _version;
    private int _remoteVersion;
    private int _size = 4;
    private string _tool = "pen";
    private string _color = "#273449";
    private string? _error;
    private string? _syncError;
    private string? _result;
    private bool _ready;
    private bool _loading = true;
    private bool _saving;
    private bool _importing;
    private bool _importError;
    private bool _conflict;
    private bool _disposed;
    private bool _refreshing;
    private bool _eventsConnected = true;
    private bool _busy => _importing;

    protected override Task OnInitializedAsync() => LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _eventModule = await JS.InvokeAsync<IJSObjectReference>("import", "./board.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            _events = await _eventModule.InvokeAsync<IJSObjectReference>("listenForChanges", _dotNetRef);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _debounce?.Cancel();
        try
        {
            var state = await Api.LoadAsync();
            ApplyState(state);
            _revision = _savedRevision = 0;
            _remoteVersion = _version;
            _activeStroke = null;
            _conflict = false;
            _importError = false;
            _error = null;
            _syncError = null;
            _result = null;
            _ready = true;
            _canvas?.Invalidate();
            if (state.PendingImport)
                await ImportPendingAsync(state);
        }
        catch (Exception ex)
        {
            if (!_ready)
                _error = $"Could not load your board: {ex.Message} Check the server and retry.";
            else
                _error = $"Could not reload the board: {ex.Message} Your local changes are still here.";
        }
        finally
        {
            _loading = false;
            if (_remoteVersion > _version && CanRefresh)
                await RefreshIfChangedAsync();
        }
    }

    private bool CanRefresh => !_disposed && _ready && !_loading && !_busy && !_saving &&
        !_conflict && _activeStroke is null && _revision == _savedRevision;

    [JSInvokable]
    public Task OnBoardChanged(int version) => InvokeAsync(async () =>
    {
        if (_disposed)
            return;
        _remoteVersion = Math.Max(_remoteVersion, version);
        await RefreshIfChangedAsync();
    });

    [JSInvokable]
    public Task OnEventConnectionChanged(bool connected) => InvokeAsync(() =>
    {
        if (_disposed)
            return;
        _eventsConnected = connected;
        StateHasChanged();
    });

    private void ApplyState(BoardState state)
    {
        Validate(state.Document);
        if (state.Document.BackgroundPngBase64 != _document.BackgroundPngBase64)
            ReplaceBackground(state.Document.BackgroundPngBase64 is { } png
                ? SketchFile.DecodeBackground(png) : null);
        _document = state.Document;
        _version = state.Version;
        _canvas?.Invalidate();
    }

    private async Task ImportPendingAsync(BoardState state)
    {
        _importing = true;
        _importError = false;
        _result = null;
        StateHasChanged();
        try
        {
            var image = await Api.LoadPendingImageAsync(state.Version);
            var png = SketchFile.ImportImage(image);
            var background = SketchFile.DecodeBackground(png);
            _debounce?.Cancel();
            _document = new BoardDocument { Notes = state.Document.Notes, BackgroundPngBase64 = png };
            ReplaceBackground(background);
            _revision++;
            _canvas?.Invalidate();
            await SaveAsync();
            if (!_conflict && _savedRevision == _revision)
            {
                _error = null;
                _result = "Image loaded from chat.";
            }
        }
        catch (Exception ex)
        {
            _importError = true;
            _error = $"Could not load the chat image: {ex.Message} Ask chat to load another file or retry.";
        }
        finally
        {
            _importing = false;
            StateHasChanged();
            if (_remoteVersion > _version && CanRefresh)
                await RefreshIfChangedAsync();
        }
    }

    private async Task RefreshIfChangedAsync()
    {
        if (_refreshing || !CanRefresh || _remoteVersion <= _version)
            return;
        _refreshing = true;
        try
        {
            while (CanRefresh && _remoteVersion > _version)
            {
                var revision = _revision;
                var version = _version;
                var state = await Api.LoadAsync();
                if (!CanRefresh || _revision != revision || _version != version)
                    return;
                ApplyState(state);
                _syncError = null;
                if (state.PendingImport)
                    await ImportPendingAsync(state);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            _syncError = $"Could not refresh the board from chat: {ex.Message} Reconnect or reload the panel.";
        }
        finally
        {
            _refreshing = false;
            StateHasChanged();
        }
    }

    private static void Validate(BoardDocument document)
    {
        if (document.Width != 1200 || document.Height != 800 ||
            document.Strokes is null || document.Notes is null ||
            document.Strokes.Count > MaxStrokes || document.Notes.Length > 10000 ||
            document.Strokes.Any(s => s.Points is null || s.Points.Count > MaxPointsPerStroke ||
                s.Size is < 1 or > 100 || s.Tool is not ("pen" or "eraser")) ||
            document.Strokes.Sum(s => s.Points.Count) > MaxPoints)
            throw new InvalidOperationException("The saved board exceeds supported dimensions or limits.");
    }

    private void ReplaceBackground(SKImage? background)
    {
        var previous = _background;
        _background = background;
        previous?.Dispose();
    }

    private void Paint(SKPaintSurfaceEventArgs e)
    {
        var canvas = e.Surface.Canvas;
        canvas.Save();
        canvas.Scale(e.Info.Width / (float)_document.Width, e.Info.Height / (float)_document.Height);
        BoardRenderer.Draw(canvas, _document, _activeStroke, _background);
        canvas.Restore();
    }

    private void StartStroke(CanvasPosition point)
    {
        if (!_ready || _busy || _activeStroke is not null)
            return;
        if (_document.Strokes.Count >= MaxStrokes ||
            _document.Strokes.Sum(s => s.Points.Count) >= MaxPoints)
        {
            _error = "Board limit reached. Undo or clear strokes to continue.";
            return;
        }
        _activeStroke = new BoardStroke { Tool = _tool, Color = _color, Size = _tool == "eraser" ? _size * 3 : _size };
        AddPoint(point);
    }

    private void AddPoint(CanvasPosition point)
    {
        if (_activeStroke is null || _activeStroke.Points.Count >= MaxPointsPerStroke ||
            _document.Strokes.Sum(s => s.Points.Count) + _activeStroke.Points.Count >= MaxPoints)
            return;
        var previous = _activeStroke.Points.LastOrDefault();
        if (previous is not null && Math.Abs(previous.X - point.X) + Math.Abs(previous.Y - point.Y) < 0.7)
            return;
        _activeStroke.Points.Add(new BoardPoint { X = point.X, Y = point.Y });
        _canvas?.Invalidate();
    }

    private void EndStroke(CanvasPosition point)
    {
        AddPoint(point);
        FinishStroke();
    }

    private void DrawingError(string message) => _error = message;

    private void CancelStroke()
    {
        if (_loading || _importing)
        {
            _activeStroke = null;
            _canvas?.Invalidate();
        }
        else
        {
            FinishStroke();
        }
    }

    private void FinishStroke()
    {
        if (_activeStroke is { Points.Count: > 0 } stroke)
        {
            _document.Strokes.Add(stroke);
            Changed();
        }
        _activeStroke = null;
        _canvas?.Invalidate();
    }

    private void Undo()
    {
        if (_activeStroke is not null)
            FinishStroke();
        if (_document.Strokes.Count == 0)
            return;
        _document.Strokes.RemoveAt(_document.Strokes.Count - 1);
        Changed();
        _canvas?.Invalidate();
    }

    private void SelectPen() => _tool = "pen";
    private void SelectEraser() => _tool = "eraser";

    private void Clear()
    {
        _activeStroke = null;
        _document.Strokes.Clear();
        _document.BackgroundPngBase64 = null;
        ReplaceBackground(null);
        Changed();
        _canvas?.Invalidate();
    }

    private void NotesChanged(ChangeEventArgs e)
    {
        var notes = e.Value?.ToString() ?? "";
        if (notes == _document.Notes)
            return;
        _document.Notes = notes[..Math.Min(notes.Length, 10000)];
        Changed();
    }

    private void Changed()
    {
        _revision++;
        _result = null;
        if (!_conflict)
            ScheduleSave();
    }

    private void ScheduleSave()
    {
        _debounce?.Cancel();
        _debounce?.Dispose();
        _debounce = new CancellationTokenSource();
        _ = DebouncedSaveAsync(_debounce.Token);
    }

    private async Task DebouncedSaveAsync(CancellationToken cancellation)
    {
        try
        {
            await Task.Delay(450, cancellation);
            if (!_disposed)
                await InvokeAsync(SaveAsync);
        }
        catch (OperationCanceledException) { }
    }

    private async Task SaveAsync()
    {
        if (_conflict || !_ready)
            return;
        await _saveGate.WaitAsync();
        try
        {
            _saving = true;
            while (_savedRevision != _revision && !_conflict)
            {
                var revision = _revision;
                try
                {
                    var document = _document.Copy();
                    var request = new SaveRequest
                    {
                        Version = _version,
                        Document = document,
                        PngBase64 = BoardRenderer.ExportPngBase64(document, _background)
                    };
                    var saved = await Api.SaveAsync(request);
                    Validate(saved.Document);
                    _version = saved.Version;
                    _savedRevision = revision;
                    if (_revision == revision && _activeStroke is null)
                    {
                        if (saved.Document.BackgroundPngBase64 != _document.BackgroundPngBase64)
                            ReplaceBackground(saved.Document.BackgroundPngBase64 is { } png
                                ? SketchFile.DecodeBackground(png) : null);
                        _document = saved.Document;
                        _canvas?.Invalidate();
                    }
                    _error = null;
                }
                catch (BoardConflictException)
                {
                    _importError = false;
                    _conflict = true;
                    _error = "This board changed in chat or another window. Copy any unsaved notes before reloading; reload the latest board to resolve the conflict.";
                }
                catch (Exception ex)
                {
                    _importError = false;
                    _error = $"Save failed: {ex.Message} Your edits remain on this page; retry before reloading.";
                    break;
                }
            }
        }
        finally
        {
            _saving = false;
            _saveGate.Release();
            StateHasChanged();
        }
        if (_remoteVersion > _version && CanRefresh)
            await RefreshIfChangedAsync();
    }

    private Task RetrySaveAsync() => SaveAsync();

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        _debounce?.Cancel();
        _debounce?.Dispose();
        if (_events is not null)
        {
            await _events.InvokeVoidAsync("close");
            await _events.DisposeAsync();
        }
        _dotNetRef?.Dispose();
        if (_eventModule is not null)
            await _eventModule.DisposeAsync();
        _background?.Dispose();
        _saveGate.Dispose();
    }
}
