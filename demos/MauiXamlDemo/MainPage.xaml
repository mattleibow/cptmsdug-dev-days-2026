<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiXamlDemo.MainPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">

    <ScrollView>
        <VerticalStackLayout Padding="24,48"
                             Spacing="0"
                             MaximumWidthRequest="480"
                             HorizontalOptions="Center">
            <VerticalStackLayout x:Name="SignInView" Spacing="20">
                <Label Text="Welcome back"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Sign in to see your dashboard"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />

                <VerticalStackLayout Spacing="8" Margin="0,20,0,0">
                    <Label Text="Email"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,4">
                        <Entry x:Name="EmailEntry"
                               Placeholder="you@example.com"
                               Keyboard="Email"
                               ReturnType="Next"
                               SemanticProperties.Description="Email address" />
                    </Border>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8">
                    <Label Text="Password"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                    <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 10"
                            Padding="12,4">
                        <Entry x:Name="PasswordEntry"
                               Placeholder="Enter your password"
                               IsPassword="True"
                               ReturnType="Go"
                               Completed="OnPasswordCompleted"
                               SemanticProperties.Description="Password" />
                    </Border>
                </VerticalStackLayout>

                <Label x:Name="ErrorLabel"
                       IsVisible="False"
                       TextColor="#B42318"
                       SemanticProperties.Description="Sign-in error" />
                <Button Text="Log in"
                        BackgroundColor="#285AE8"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="54"
                        Clicked="OnLoginClicked"
                        SemanticProperties.Hint="Opens the demo dashboard when both fields are valid" />
                <Label Text="Demo mode: any email and non-empty password opens the dashboard. No account is authenticated."
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
            </VerticalStackLayout>

            <VerticalStackLayout x:Name="DashboardView" IsVisible="False" Spacing="18">
                <Label Text="Dashboard"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label x:Name="WelcomeLabel"
                       FontSize="16"
                       TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                <Label Text="Sample overview"
                       FontSize="14"
                       FontAttributes="Bold"
                       Margin="0,16,0,0"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />

                <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Projects"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="03"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#285AE8" />
                    </VerticalStackLayout>
                </Border>
                <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Tasks"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="12"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#285AE8" />
                    </VerticalStackLayout>
                </Border>
                <Border Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="20">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Updates"
                               FontSize="16"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}" />
                        <Label Text="05"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#285AE8" />
                    </VerticalStackLayout>
                </Border>
                <Button Text="Back to sign in"
                        Clicked="OnSignOutClicked"
                        Margin="0,12,0,0"
                        SemanticProperties.Hint="Returns to the demo sign-in screen" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
