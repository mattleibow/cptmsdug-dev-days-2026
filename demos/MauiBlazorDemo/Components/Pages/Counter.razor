@page "/counter"
@using CounterCore

<h1>Counter</h1>

<p id="count-label" class="mb-2">Current count</p>
<div class="d-flex align-items-center gap-3">
    <button class="btn btn-primary" @onclick="DecrementCount">- Decrease</button>
    <output class="display-4" aria-labelledby="count-label" aria-live="polite" aria-atomic="true">@counter.Count</output>
    <button class="btn btn-primary" @onclick="IncrementCount">+ Increase</button>
</div>

@code {
    private readonly CounterService counter = new();

    private void IncrementCount()
    {
        counter.Increment();
    }

    private void DecrementCount()
    {
        counter.Decrement();
    }
}
