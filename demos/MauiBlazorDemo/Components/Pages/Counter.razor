@page "/counter"
@using CounterCore

<h1>Counter</h1>

<div class="d-flex align-items-center gap-3 flex-wrap">
    <button type="button" class="btn btn-primary" aria-label="Decrease count" @onclick="DecrementCount">− Minus</button>
    <output role="status" aria-live="polite" aria-atomic="true">
        <span class="fs-5">Current count:</span> <strong class="display-4">@counter.Count</strong>
    </output>
    <button type="button" class="btn btn-primary" aria-label="Increase count" @onclick="IncrementCount">+ Plus</button>
</div>

@code {
    private readonly CounterService counter = new();

    private void IncrementCount()
    {
        counter.Increment();
    }

    private void DecrementCount()
    {
        counter.Decrement();
    }
}
